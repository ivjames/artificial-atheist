# Copy to .env and fill in. Both Prisma and Next.js read this file.

# PostgreSQL connection string.
#   Local dev:  postgresql://aiq:aiqpass@127.0.0.1:5432/atheismiq?schema=public
#   Droplet:    postgresql://<user>:<pass>@127.0.0.1:5432/atheismiq?schema=public
DATABASE_URL="postgresql://aiq:aiqpass@127.0.0.1:5432/atheismiq?schema=public"

# Public site URL — baked into share links and OG images at build time.
#   Local dev:  http://localhost:3000
#   Production: https://atheismiq.lab980.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Port the Next.js server listens on (must match nginx upstream + pm2 config).
#   Local dev: 3000   |   lab980 droplet: 8060
PORT=3000

# ===========================================================================
# Debate chat agent + credit system (ArtificialAtheist integration)
# ---------------------------------------------------------------------------
# LEGAL GATE: leave CHAT_ENABLED=false until the §6 consent/privacy review is
# signed off (see LAUNCH-BLOCKERS.md). While false the whole chat surface is
# dark and no email/conversation data is collected.
# ===========================================================================
CHAT_ENABLED=false

# Signs the session cookie. Generate: `openssl rand -base64 32`. Required
# whenever CHAT_ENABLED=true.
SESSION_SECRET=""

# --- Model provider API keys (only the ones your slots use are needed) ---
ANTHROPIC_API_KEY=""
MISTRAL_API_KEY=""

# --- Model routing per slot (defaults shown; override to swap vendor/model) ---
# Slot A standard (chat default) — Claude Haiku 4.5.
# MODEL_STANDARD_PROVIDER=anthropic
# MODEL_STANDARD=claude-haiku-4-5
# Slot A premium "deep debate" — Claude Sonnet (interim).
# MODEL_PREMIUM_PROVIDER=anthropic
# MODEL_PREMIUM=claude-sonnet-4-5
# Slot B article writer / Slot C scrub.
# MODEL_WRITER=claude-sonnet-4-5
# MODEL_SCRUB=claude-sonnet-4-5
# EU-jurisdiction alternative for Slot A standard:
# MODEL_STANDARD_PROVIDER=mistral
# MODEL_STANDARD=mistral-large-latest

# --- Credit economics (§4/§8; all tunable) ---
# FREE_QUESTION_QUOTA=5
# STANDARD_CREDIT_COST=1
# PREMIUM_CREDIT_COST=3
# THREAD_TOKEN_BUDGET=40000
# MAX_OUTPUT_TOKENS=800

# --- Article pipeline (§5): min DISTINCT users before a topic is eligible ---
# CLUSTER_MIN_USERS=6
# The scheduled `pipeline:auto` job always clusters; set this to also draft +
# scrub queued drafts automatically (costs model spend). Publishing stays human-gated.
# PIPELINE_AUTODRAFT=1
# Token gating /review/pipeline (the article-review queue). Unset → /review 404s.
ADMIN_TOKEN=""

# --- Abuse rate limits (§8; in-memory per process, best-effort) ---
# RL_AUTH_IP_PER_HOUR=10
# RL_AUTH_EMAIL_PER_HOUR=5
# RL_CHAT_PER_MIN=20

# --- Pre-launch preview lock ----------------------------------------------
# Make the chat surface PRIVATE for a pre-launch test without HTTP basic-auth.
# Set CHAT_ENABLED=true AND a secret here; then the only way in is to open any
# chat URL once with ?preview=<this value> (sets a 30-day cookie). Everyone else
# gets a 404, and a valid preview cookie also bypasses the region gate. Leave
# UNSET for real (public) launch. Example entry link:
#   https://artificialatheist.com/age?preview=YOUR-SECRET
# CHAT_PREVIEW_TOKEN=""

# --- Region gate ("GDPR sidestep", LAUNCH-BLOCKERS.md §1/§2) ---------------
# Declines the chat surface to visitors in GDPR/UK-GDPR regions so no
# special-category conversation data from those data subjects is collected.
# ON by default whenever CHAT_ENABLED=true (fails toward protection). Risk
# reduction, not full compliance — geolocation is imperfect; counsel should
# still bless it. Requires a country signal: on the droplet, configure nginx's
# GeoIP2 module to set the header below (proxy_set_header X-Country-Code ...).
# GEO_GATE_ENABLED=true
# Name of the request header carrying the ISO-3166-1 alpha-2 country. This is
# the ONLY header trusted for geolocation — the proxy must set it AND strip any
# client-supplied copy, or a visitor could spoof it. Default x-country-code.
# Behind Cloudflare, set this to cf-ipcountry instead.
# GEO_COUNTRY_HEADER=x-country-code
# Default blocklist is EU/EEA + UK. Override/replace with a comma list:
# GEO_BLOCKED_COUNTRIES=AT,BE,BG,...
# Optional STRICT allowlist — if set, ONLY these countries are served (e.g.
# US-only). Takes precedence over the blocklist.
# GEO_ALLOWED_COUNTRIES=US
# When the country can't be determined: unset/false = block (fail closed,
# default); true = allow. Leave closed in production.
# GEO_FAIL_OPEN=false
# LOCAL DEV ONLY: assume this country when no proxy header is present, so the
# gate doesn't block you on localhost. Do NOT set in production.
# GEO_DEFAULT_COUNTRY=US

# --- Payments (Stripe not provisioned yet → defaults to the dev "stub") ---
# PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email (magic-link contact gate). Unset → console transport (logs the
#     link to the server log, enough to develop/test offline). ---
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Artificial Atheist <no-reply@artificialatheist.com>"
