# systemd unit for the AtheismIQ Next.js server.
# Adjust User/paths to match your lab980 layout, then:
#   sudo cp deploy/artificial-atheist.service /etc/systemd/system/artificial-atheist.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now artificial-atheist
#   sudo systemctl status artificial-atheist   # logs: journalctl -u artificial-atheist -f
#
# Next.js + Prisma read the app's .env for DATABASE_URL / NEXT_PUBLIC_SITE_URL.

[Unit]
Description=Artificial Atheist (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# --- adjust to your convention ---
User=deploy
WorkingDirectory=/var/www/artificial-atheist
Environment=NODE_ENV=production
Environment=PORT=8060
# Fallback visitor region when no trusted geo header (x-country-code) is present,
# so header-less requests resolve to an allowed region instead of failing closed
# to /unavailable. Interim default — for launch, wire real geolocation via
# deploy/nginx-geoip2.conf so true countries are detected and the GDPR region
# gate actually applies. After editing this unit: re-copy it, then
#   sudo systemctl daemon-reload && sudo systemctl restart artificial-atheist
Environment=GEO_DEFAULT_COUNTRY=US
# npm must be on PATH for the unit; use an absolute path if you use nvm.
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
